## Copy this file to .env.local (gitignored) and fill in real values for local dev.
## For the deployed build, set the same two names as GitHub Actions repo secrets:
## Settings -> Secrets and variables -> Actions -> New repository secret.

# https://formspree.io — create a form pointed at your destination inbox,
# then use the endpoint URL it gives you.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# https://www.google.com/recaptcha/admin — register the site, choosing v3.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
